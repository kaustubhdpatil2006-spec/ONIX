{
    "rules_version": "Legal Metrology Packaged Commodities Rules, 2011 - NLP Prototype",

    "categories": {
        "product_identity": {
            "required": true,
            "description": "Common or generic name of the commodity",
            "patterns": [
                "product name",
                "common name",
                "generic name",
                "commodity"
            ]
        },

        "manufacturer_details": {
            "required": true,
            "description": "Name and address of manufacturer, packer or importer",
            "patterns": [
                "manufactured by",
                "manufactured for",
                "packed by",
                "imported by",
                "manufacturer",
                "packer",
                "importer"
            ]
        },

        "country_of_origin": {
            "required": false,
            "description": "Country of origin for imported products",
            "patterns": [
                "country of origin",
                "made in",
                "product of"
            ]
        },

        "net_quantity": {
            "required": true,
            "description": "Net quantity in standard unit of weight, measure or number",
            "patterns": [
                "net quantity",
                "net qty",
                "net weight",
                "net wt",
                "net volume",
                "quantity"
            ]
        },

        "manufacturing_date": {
            "required": true,
            "description": "Month and year of manufacture, packing or import, subject to applicable provisions",
            "patterns": [
                "mfg",
                "mfd",
                "manufacturing date",
                "date of manufacture",
                "packed",
                "packing date"
            ]
        },

        "best_before_use_by": {
            "required": false,
            "description": "Best before or use by declaration where applicable",
            "patterns": [
                "best before",
                "best before end",
                "use by",
                "use before",
                "expiry",
                "expires",
                "expiry date"
            ]
        },

        "mrp": {
            "required": true,
            "description": "Maximum Retail Price inclusive of all taxes",
            "patterns": [
                "mrp",
                "maximum retail price",
                "max retail price",
                "retail sale price"
            ]
        },

        "unit_sale_price": {
            "required": false,
            "description": "Unit sale price where applicable",
            "patterns": [
                "unit sale price",
                "sale price per",
                "price per",
                "per kg",
                "per g",
                "per ml",
                "per litre",
                "per liter",
                "per unit"
            ]
        },

        "consumer_care": {
            "required": true,
            "description": "Consumer care contact details",
            "patterns": [
                "consumer care",
                "consumer complaint",
                "customer care",
                "customer service",
                "helpline",
                "toll free",
                "contact us",
                "email",
                "e-mail"
            ]
        },

        "dimensions_size": {
            "required": false,
            "description": "Dimensions of the commodity where relevant",
            "patterns": [
                "dimensions",
                "dimension",
                "size",
                "length",
                "width",
                "height",
                "depth",
                "diameter"
            ]
        }
    }
}